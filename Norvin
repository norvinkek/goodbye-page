
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Goodbye for now</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
<style>
  :root{
    --ink:#2B2118;
    --paper:#FFF7ED;
    --card:#ffffff;
    --border:#F0DFC9;
    --grey-text:#8a7c6b;

    --accent:#FF6B4A;
    --accent-light:#FF8A6E;

    --telegram:#29A9EA;
    --instagram:#D6249F;
    --linkedin:#0A66C2;

    --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    --heading-font: "Fredoka", sans-serif;
    --body-font: "Poppins", sans-serif;
  }
  *{ box-sizing:border-box; }
  html,body{
    margin:0; padding:0; min-height:100%;
    background:var(--paper);
    font-family:var(--body-font);
    color:var(--ink);
  }
  .app{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
  }
  .card{
    position:relative;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:16px;
    box-shadow:0 10px 30px rgba(0,0,0,0.06);
    width:100%;
    max-width:560px;
    padding:36px 32px;
    transition:opacity 0.4s ease, transform 0.4s ease;
    overflow:hidden;
  }
  .card.final-card{ max-width:820px; }

  .fade-out{ opacity:0; transform:translateY(-12px); }
  .fade-in-start{ opacity:0; transform:translateY(12px); }

  .top-row{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    margin-bottom:22px;
    flex-wrap:wrap;
    gap:8px;
  }
  h1.title{
    font-family:var(--heading-font);
    font-size:28px;
    line-height:1.3;
    margin:0;
    font-weight:700;
  }
  .est-time{
    font-family:var(--mono);
    font-size:11px;
    color:var(--grey-text);
    white-space:nowrap;
  }
  .body-copy p{
    font-family:var(--body-font);
    font-weight:400;
    font-size:15px;
    line-height:1.7;
    color:#3a2f24;
    margin:0 0 14px;
  }
  .question{
    font-family:var(--heading-font);
    font-size:24px;
    font-weight:600;
    margin:26px 0 6px;
  }
  .loop-note{
    font-family:var(--mono);
    font-size:11px;
    color:var(--accent);
    min-height:16px;
    margin-bottom:14px;
  }

  .btn-row{
    display:flex;
    gap:12px;
    margin-top:18px;
    min-height:64px;
  }
  .yes-lane{
    flex:1;
    display:flex;
  }
  .no-lane{
    position:relative;
    flex:1;
    min-height:64px;
  }
  .btn{
    border:none;
    border-radius:12px;
    font-family:var(--heading-font);
    font-weight:600;
    font-size:16px;
    cursor:pointer;
    transition:transform 0.15s ease, background 0.2s ease, font-size 0.2s ease, width 0.2s ease, height 0.2s ease;
  }
  .btn:active{ transform:scale(0.97); }
  .btn-yes{
    background:var(--accent);
    color:#fff;
    width:100%;
    height:56px;
  }
  .btn-yes:hover{ background:var(--accent-light); }
  .btn-no{
    position:absolute;
    background:var(--ink);
    color:#fff;
    width:100%;
    height:56px;
    top:0;
    left:0;
    z-index:5;
    font-size:16px;
  }
  .toast{
    position:fixed;
    bottom:24px;
    left:50%;
    transform:translateX(-50%) translateY(20px);
    background:var(--ink);
    color:#fff;
    font-family:var(--mono);
    font-size:12px;
    padding:10px 16px;
    border-radius:8px;
    opacity:0;
    transition:opacity 0.25s ease, transform 0.25s ease;
    pointer-events:none;
    z-index:50;
    max-width:80vw;
    text-align:center;
  }
  .toast.show{
    opacity:1;
    transform:translateX(-50%) translateY(0);
  }

  .section-title{
    font-family:var(--heading-font);
    font-size:24px;
    font-weight:700;
    margin:0 0 6px;
  }
  .section-sub{
    font-family:var(--body-font);
    font-size:14px;
    color:var(--grey-text);
    margin:0 0 26px;
  }
  .qr-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:16px;
  }
  @media(min-width:640px){
    .qr-grid{ grid-template-columns:repeat(3,1fr); }
  }
  .qr-card{
    border:2px solid var(--border);
    border-radius:14px;
    padding:22px 18px;
    text-align:center;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:10px;
  }
  .qr-card.telegram{ border-color:var(--telegram); }
  .qr-card.instagram{ border-color:var(--instagram); }
  .qr-card.linkedin{ border-color:var(--linkedin); }

  .qr-card h3{
    font-family:var(--heading-font);
    font-size:15px;
    letter-spacing:0.03em;
    margin:0;
    font-weight:600;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
  }
  .qr-card.telegram h3 svg{ color:var(--telegram); }
  .qr-card.instagram h3 svg{ color:var(--instagram); }
  .qr-card.linkedin h3 svg{ color:var(--linkedin); }
  .qr-card h3 svg{
    width:20px;
    height:20px;
    flex-shrink:0;
  }
  .qr-card p{
    font-family:var(--body-font);
    font-size:12.5px;
    color:var(--grey-text);
    margin:0;
    line-height:1.5;
  }
  .qr-img canvas{ border-radius:8px; }
  .open-link{
    margin-top:6px;
    font-family:var(--heading-font);
    font-size:13px;
    font-weight:600;
    text-decoration:none;
    border:none;
    cursor:pointer;
    padding:8px 16px;
    border-radius:8px;
    color:#fff;
  }
  .open-link.telegram{ background:var(--telegram); }
  .open-link.instagram{ background:var(--instagram); }
  .open-link.linkedin{ background:var(--linkedin); }
  .open-link:hover{ filter:brightness(1.08); }

  .footer-line{
    margin-top:30px;
    text-align:center;
    font-family:var(--heading-font);
    font-size:14px;
    color:var(--grey-text);
  }

  /* Comment box */
  .comment-box{
    margin-top:32px;
    padding-top:24px;
    border-top:1px dashed var(--border);
  }
  .comment-title{
    font-family:var(--heading-font);
    font-size:16px;
    font-weight:600;
    margin:0 0 12px;
    text-align:center;
  }
  .comment-input, .comment-textarea{
    width:100%;
    font-family:var(--body-font);
    font-size:14px;
    padding:12px 14px;
    border:1px solid var(--border);
    border-radius:10px;
    margin-bottom:10px;
    resize:vertical;
  }
  .comment-textarea{ min-height:90px; }
  .comment-input:focus, .comment-textarea:focus{
    outline:none;
    border-color:var(--accent);
  }
  .comment-submit{
    background:var(--accent);
    color:#fff;
    width:100%;
    height:48px;
  }
  .comment-submit:hover{ background:var(--accent-light); }
  .comment-submit:disabled{ opacity:0.6; cursor:not-allowed; }
  .comment-status{
    font-family:var(--mono);
    font-size:12px;
    color:var(--grey-text);
    margin-top:10px;
    min-height:14px;
    text-align:center;
  }

  .hidden{ display:none !important; }
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute">
  <defs>
    <symbol id="icon-telegram" viewBox="0 0 24 24">
      <path fill="currentColor" d="M21.05 3.16 2.7 10.36c-1.26.5-1.25 1.2-.23 1.51l4.7 1.47 1.82 5.6c.22.6.36.85.75.85.3 0 .43-.14.6-.3l2.65-2.55 4.87 3.6c.9.5 1.55.24 1.78-.83l3.2-15.1c.33-1.31-.5-1.9-1.79-1.45zM8.6 13.6l9.03-5.68c.43-.26.82-.12.5.17l-7.5 6.8-.3 3.2z"/>
    </symbol>
    <symbol id="icon-instagram" viewBox="0 0 24 24">
      <path fill="none" stroke="currentColor" stroke-width="1.8" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z"/>
      <circle cx="12" cy="12" r="3.7" fill="none" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor"/>
    </symbol>
    <symbol id="icon-linkedin" viewBox="0 0 24 24">
      <path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.6v1.64h.05c.5-.95 1.72-1.95 3.55-1.95 3.8 0 4.5 2.5 4.5 5.76V21H17v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V21H9z"/>
    </symbol>
  </defs>
</svg>

<div class="app">

  <div class="card" id="screen1">
    <div class="top-row">
      <h1 class="title">GOODBYE FOR NOW!</h1>
      <span class="est-time">EST. TIME: 8s</span>
    </div>

    <div class="body-copy">
      <p>Thanks for making my one-year internship considerably more fun than it had any right to be.</p>
      <p>To everyone reading this: thank you. Whether we worked together, crossed paths at an event, or simply existed in the same office LOL.</p>
      <p>I hope this isn't goodbye for good, so I have one question.</p>
    </div>

    <div class="question">Will we keep in contact?</div>
    <div class="loop-note" id="loop-note"></div>

    <div class="btn-row">
      <div class="yes-lane">
        <button class="btn btn-yes" id="btn-yes">Yes, of course</button>
      </div>
      <div class="no-lane" id="no-lane">
        <button class="btn btn-no" id="btn-no">No</button>
      </div>
    </div>
  </div>

  <div class="card final-card hidden" id="screen2">
    <h2 class="section-title">GOOD. THAT WOULD HAVE BEEN AWKWARD.</h2>
    <p class="section-sub">Choose your preferred way to keep in contact.</p>

    <div class="qr-grid">
      <div class="qr-card telegram">
        <h3><svg><use href="#icon-telegram"/></svg> TELEGRAM</h3>
        <p>Reach out anytime.<br/>About anything. Actually.</p>
        <div class="qr-img" id="qr-telegram"></div>
        <a class="open-link telegram" id="open-telegram" target="_blank" rel="noopener">Open Telegram →</a>
      </div>
      <div class="qr-card instagram">
        <h3><svg><use href="#icon-instagram"/></svg> INSTAGRAM</h3>
        <p>See what I'm doing.<br/>Mainly what I cook / eat.</p>
        <div class="qr-img" id="qr-instagram"></div>
        <a class="open-link instagram" id="open-instagram" target="_blank" rel="noopener">Open Instagram →</a>
      </div>
      <div class="qr-card linkedin">
        <h3><svg><use href="#icon-linkedin"/></svg> LINKEDIN</h3>
        <p>Of course.<br/>I had to — this is corporate.</p>
        <div class="qr-img" id="qr-linkedin"></div>
        <a class="open-link linkedin" id="open-linkedin" target="_blank" rel="noopener">Open LinkedIn →</a>
      </div>
    </div>

    <p class="footer-line">See you again soon :)</p>

    <div class="comment-box">
      <h3 class="comment-title">Leave a note before you go</h3>
      <form id="comment-form">
        <input type="hidden" name="access_key" value="aca458b0-218f-4a4d-ad14-be7459d0d7fc">
        <input type="hidden" name="subject" value="New note from your goodbye page">
        <input type="text" name="name" placeholder="Your name (optional)" class="comment-input">
        <textarea name="message" placeholder="Say something..." required class="comment-textarea"></textarea>
        <button type="submit" class="btn comment-submit" id="comment-submit-btn">Send</button>
      </form>
      <p class="comment-status" id="comment-status"></p>
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<script>
const CONFIG = {
  telegram: "https://t.me/norvincake",
  instagram: "https://instagram.com/norvin.cake",
  linkedin: "https://linkedin.com/in/norvinkek/"
};

let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 1600);
}

const noLabels = ["No", "Really?", "Interesting.", "Try again.", "Nope, still no.", "Persistent."];
const toastMessages = [
  "That option appears to be unavailable.",
  "Please select an evidence-based response.",
  "Your feedback has been escalated for reconsideration.",
  "Still not an option.",
  "This button does not do that."
];

function setupEndlessDodge(){
  const lane = document.getElementById('no-lane');
  const noBtn = document.getElementById('btn-no');
  const loopNote = document.getElementById('loop-note');
  let attempts = 0;

  function shrinkForDodge(){
    noBtn.style.width = '90px';
    noBtn.style.height = '48px';
    noBtn.style.fontSize = '13px';
  }

  function randomPosition(){
    const laneRect = lane.getBoundingClientRect();
    const btnW = noBtn.offsetWidth || 90;
    const btnH = noBtn.offsetHeight || 48;
    const maxX = Math.max(0, laneRect.width - btnW);
    const maxY = Math.max(0, laneRect.height - btnH);
    const x = Math.random() * maxX;
    const y = Math.random() * maxY;
    noBtn.style.left = `${x}px`;
    noBtn.style.top = `${y}px`;
  }

  function handleDodge(e){
    e.preventDefault();
    attempts++;

    if (attempts === 1){
      shrinkForDodge();
    }
    randomPosition();

    const labelIdx = Math.min(attempts - 1, noLabels.length - 1);
    noBtn.textContent = noLabels[labelIdx];

    const toastIdx = Math.min(attempts - 1, toastMessages.length - 1);
    showToast(toastMessages[toastIdx]);

    if (attempts > 3){
      loopNote.textContent = `[ attempt ${attempts} — "Yes, of course" remains the only valid response ]`;
    }
  }

  noBtn.addEventListener('pointerdown', handleDodge);
}
setupEndlessDodge();

document.getElementById('btn-yes').addEventListener('click', () => {
  const yesBtn = document.getElementById('btn-yes');
  const noBtn = document.getElementById('btn-no');
  const screen1 = document.getElementById('screen1');
  const screen2 = document.getElementById('screen2');

  yesBtn.textContent = "That's more like it!";
  yesBtn.disabled = true;
  noBtn.style.display = 'none';

  setTimeout(() => {
    screen1.classList.add('fade-out');
    setTimeout(() => {
      screen1.classList.add('hidden');
      screen2.classList.remove('hidden');
      screen2.classList.add('fade-in-start');
      requestAnimationFrame(() => {
        screen2.classList.remove('fade-in-start');
      });
      renderQRCodes();
    }, 400);
  }, 1000);
});

function renderQRCodes(){
  ['telegram','instagram','linkedin'].forEach(key => {
    const el = document.getElementById(`qr-${key}`);
    if (el.dataset.rendered) return;
    QRCode.toCanvas(CONFIG[key], { width: 130, margin: 1 }, (err, canvas) => {
      if (!err) el.appendChild(canvas);
    });
    el.dataset.rendered = "1";
  });
}

document.getElementById('open-telegram').href = CONFIG.telegram;
document.getElementById('open-instagram').href = CONFIG.instagram;
document.getElementById('open-linkedin').href = CONFIG.linkedin;

document.getElementById('comment-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const form = e.target;
  const statusEl = document.getElementById('comment-status');
  const btn = document.getElementById('comment-submit-btn');

  btn.disabled = true;
  btn.textContent = 'Sending...';
  statusEl.textContent = '';

  try {
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(form)))
    });
    const result = await res.json();

    if (result.success){
      statusEl.textContent = 'Sent. Thank you :)';
      form.reset();
      btn.textContent = 'Send';
    } else {
      throw new Error(result.message || 'Something went wrong');
    }
  } catch (err){
    statusEl.textContent = 'Could not send — please try again.';
    btn.textContent = 'Send';
  } finally {
    btn.disabled = false;
  }
});
</script>

</body>
</html>
